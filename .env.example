# Writing the e-book — set ONE of these:
#   Claude (best quality, paid): https://platform.claude.com
ANTHROPIC_API_KEY=
#   OpenRouter (free models): https://openrouter.ai/keys — used when ANTHROPIC_API_KEY is empty
OPENROUTER_API_KEY=
# Groq API key — free tier, transcribes audio with Whisper large-v3 (https://console.groq.com)
GROQ_API_KEY=
# Optional: if set, visitors must enter this code before the app calls any paid API
ACCESS_CODE=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
# OPENROUTER_MODELS=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
# WRITER_PROVIDER=openrouter   # or anthropic, when both keys are set
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# OPENAI_API_KEY=            # paid alternative to Groq for transcription
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_PROVIDER=groq    # or openai, when both keys are set
# MOCK_AI=1   # fake transcription/generation for UI testing without keys
