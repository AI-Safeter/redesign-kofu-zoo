# Writing the e-book: Claude Sonnet 5.5 through Nous Portal (https://portal.nousresearch.com),
# falling back to free OpenRouter models when Nous fails.
NOUS_API_KEY=
# OpenRouter (https://openrouter.ai/keys): speech recognition and the free fallback writers
OPENROUTER_API_KEY=
# Optional: Claude through Anthropic's own API instead (takes priority when set)
# ANTHROPIC_API_KEY=
# Transcription: with OPENROUTER_API_KEY set, audio models (Qwen 3.8 Omni Flash, ~$0.02/hour of audio)
# transcribe first; Groq Whisper (free) is the fallback.
# Groq API key (https://console.groq.com)
GROQ_API_KEY=
# Publishing read-only book pages: set automatically when a Vercel Blob store is connected
# BLOB_READ_WRITE_TOKEN=
# Optional: if set, visitors must enter this code before the app calls any paid API
ACCESS_CODE=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,baidu/ernie-5.5-flash-preview:free,google/gemma-4-31b-it:free
# OPENROUTER_AUDIO_MODELS=qwen/qwen3.8-omni-flash,google/gemini-2.5-flash
# TRANSCRIBE_PROVIDER=openrouter   # or groq / openai
# NOUS_MODELS=anthropic/claude-sonnet-5.5
# WRITER_EFFORT=low
# WRITER_PROVIDER=gateway   # or anthropic, when both kinds of key are set
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# OPENAI_API_KEY=            # paid alternative to Groq for transcription
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# MOCK_AI=1   # fake transcription/generation for UI testing without keys
